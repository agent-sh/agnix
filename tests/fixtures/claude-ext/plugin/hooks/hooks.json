{
  "hooks": {
    "PreToolUse": [
      { "matcher": "mcp__db__.*", "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/audit.sh" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/flush.sh", "timeout": 10 }] }
    ]
  }
}
