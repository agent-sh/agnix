{
  "mcpServers": {
    "workspace": { "type": "stdio", "command": "node", "args": ["server.js"] },
    "local": { "type": "stdio", "command": "${CLAUDE_PROJECT_DIR}/bin/server", "alwaysLoad": "true" },
    "gateway": {
      "type": "http",
      "url": "https://gateway.example.com/mcp",
      "headers": { "Authorization": "Bearer ${ANTHROPIC_API_KEY}" }
    }
  }
}
