{
  "version": "v1",
  "hooks": [
    {
      "name": "Lint on save",
      "description": "Run ESLint when the agent saves a TypeScript file",
      "trigger": "PostFileSave",
      "matcher": "\\.(ts|tsx)$",
      "action": { "type": "command", "command": "npx eslint --fix \"$(jq -r .file_path)\"" },
      "timeout": 30,
      "enabled": true
    }
  ]
}
