{
  "$schema": "https://raw.githubusercontent.com/google-gemini/gemini-cli/main/schemas/settings.schema.json",
  "general": {},
  "model": {},
  "hooksConfig": {
    "enabled": true,
    "disabled": [],
    "notifications": true
  },
  "hooks": {
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "pre-agent-hook",
            "type": "command",
            "command": "echo starting agent"
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo agent finished",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "docs": {
      "command": "node",
      "args": ["server.js"]
    }
  },
  "experimental": {
    "autoMemory": true
  }
}
