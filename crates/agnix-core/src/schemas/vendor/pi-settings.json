{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.dev/schemas/settings.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "lastChangelogVersion": {
      "type": "string"
    },
    "defaultProvider": {
      "type": "string"
    },
    "defaultModel": {
      "type": "string"
    },
    "defaultThinkingLevel": {
      "$ref": "#/$defs/ModelThinkingLevel"
    },
    "modelThinkingLevels": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "$ref": "#/$defs/ModelThinkingLevel"
        }
      }
    },
    "transport": {
      "anyOf": [
        {
          "type": "string",
          "const": "auto"
        },
        {
          "type": "string",
          "const": "sse"
        },
        {
          "type": "string",
          "const": "websocket"
        },
        {
          "type": "string",
          "const": "websocket-cached"
        }
      ]
    },
    "sessionShareDestination": {
      "anyOf": [
        {
          "type": "string",
          "const": "auto"
        },
        {
          "type": "string",
          "const": "gist"
        },
        {
          "type": "string",
          "const": "radius"
        }
      ]
    },
    "steeringMode": {
      "anyOf": [
        {
          "type": "string",
          "const": "all"
        },
        {
          "type": "string",
          "const": "one-at-a-time"
        }
      ]
    },
    "followUpMode": {
      "anyOf": [
        {
          "type": "string",
          "const": "all"
        },
        {
          "type": "string",
          "const": "one-at-a-time"
        }
      ]
    },
    "theme": {
      "type": "string"
    },
    "compaction": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "reserveTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "keepRecentTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modelOverrides": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "object",
              "properties": {
                "reserveTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "keepRecentTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        }
      }
    },
    "branchSummary": {
      "type": "object",
      "properties": {
        "reserveTokens": {
          "type": "number"
        },
        "skipPrompt": {
          "type": "boolean"
        }
      }
    },
    "retry": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxRetries": {
          "type": "number"
        },
        "baseDelayMs": {
          "type": "number"
        },
        "maxAgentDelayMs": {
          "type": "number"
        },
        "provider": {
          "type": "object",
          "properties": {
            "timeoutMs": {
              "type": "number"
            },
            "maxRetries": {
              "type": "number"
            },
            "maxRetryDelayMs": {
              "type": "number"
            }
          }
        },
        "maxDelayMs": {
          "type": "number"
        }
      }
    },
    "hideThinkingBlock": {
      "type": "boolean"
    },
    "showCacheMissNotices": {
      "type": "boolean"
    },
    "externalEditor": {
      "type": "string"
    },
    "shellPath": {
      "type": "string"
    },
    "quietStartup": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "const": "header"
        }
      ]
    },
    "defaultProjectTrust": {
      "anyOf": [
        {
          "type": "string",
          "const": "ask"
        },
        {
          "type": "string",
          "const": "always"
        },
        {
          "type": "string",
          "const": "never"
        }
      ]
    },
    "shellCommandPrefix": {
      "type": "string"
    },
    "npmCommand": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "collapseChangelog": {
      "type": "boolean"
    },
    "enableInstallTelemetry": {
      "type": "boolean"
    },
    "enableAnalytics": {
      "type": "boolean"
    },
    "trackingId": {
      "type": "string"
    },
    "packages": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "autoload": {
                "type": "boolean"
              },
              "extensions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "prompts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "themes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deviceId": {
      "type": "string"
    },
    "skills": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "properties": {
            "enableSkillCommands": {
              "type": "boolean"
            },
            "customDirectories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "enableSkillCommands": {
      "type": "boolean"
    },
    "terminal": {
      "type": "object",
      "properties": {
        "showImages": {
          "type": "boolean"
        },
        "imageWidthCells": {
          "type": "number"
        },
        "clearOnShrink": {
          "type": "boolean"
        },
        "showTerminalProgress": {
          "type": "boolean"
        },
        "hyperlinks": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "auto"
            }
          ]
        },
        "images": {
          "anyOf": [
            {
              "type": "string",
              "const": "kitty"
            },
            {
              "type": "string",
              "const": "iterm2"
            },
            {
              "type": "string",
              "const": "auto"
            },
            {
              "type": "boolean",
              "const": false
            }
          ]
        },
        "trueColor": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "const": "auto"
            }
          ]
        }
      }
    },
    "images": {
      "type": "object",
      "properties": {
        "autoResize": {
          "type": "boolean"
        },
        "blockImages": {
          "type": "boolean"
        }
      }
    },
    "enabledModels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaultTools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "doubleEscapeAction": {
      "anyOf": [
        {
          "type": "string",
          "const": "fork"
        },
        {
          "type": "string",
          "const": "tree"
        },
        {
          "type": "string",
          "const": "none"
        }
      ]
    },
    "treeFilterMode": {
      "anyOf": [
        {
          "type": "string",
          "const": "default"
        },
        {
          "type": "string",
          "const": "no-tools"
        },
        {
          "type": "string",
          "const": "user-only"
        },
        {
          "type": "string",
          "const": "labeled-only"
        },
        {
          "type": "string",
          "const": "all"
        }
      ]
    },
    "thinkingBudgets": {
      "type": "object",
      "properties": {
        "minimal": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "medium": {
          "type": "number"
        },
        "high": {
          "type": "number"
        }
      }
    },
    "editorPaddingX": {
      "type": "number"
    },
    "outputPad": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        }
      ]
    },
    "autocompleteMaxVisible": {
      "type": "number"
    },
    "showHardwareCursor": {
      "type": "boolean"
    },
    "markdown": {
      "type": "object",
      "properties": {
        "codeBlockIndent": {
          "type": "string"
        },
        "mermaid": {
          "anyOf": [
            {
              "type": "string",
              "const": "off"
            },
            {
              "type": "string",
              "const": "final"
            },
            {
              "type": "string",
              "const": "streaming"
            }
          ]
        }
      }
    },
    "warnings": {
      "type": "object",
      "properties": {
        "anthropicExtraUsage": {
          "type": "boolean"
        }
      }
    },
    "codemode": {
      "type": "object",
      "properties": {
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "const": "on"
            },
            {
              "type": "string",
              "const": "only"
            }
          ]
        },
        "inlineBudget": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "sessionDir": {
      "type": "string"
    },
    "httpProxy": {
      "type": "string"
    },
    "httpIdleTimeoutMs": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "const": "disabled"
        }
      ]
    },
    "cacheWarming": {
      "anyOf": [
        {
          "type": "string",
          "const": "off"
        },
        {
          "type": "string",
          "const": "streaming"
        },
        {
          "type": "string",
          "const": "idle"
        }
      ]
    },
    "websocketConnectTimeoutMs": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "const": "disabled"
        }
      ]
    },
    "tuiMode": {
      "anyOf": [
        {
          "type": "string",
          "const": "regular"
        },
        {
          "type": "string",
          "const": "fullscreen"
        }
      ]
    },
    "fullscreenExitOutput": {
      "anyOf": [
        {
          "type": "string",
          "const": "transcript"
        },
        {
          "type": "string",
          "const": "resume-hint"
        }
      ]
    },
    "fullscreenScrollbar": {
      "anyOf": [
        {
          "type": "string",
          "const": "auto"
        },
        {
          "type": "string",
          "const": "always"
        },
        {
          "type": "string",
          "const": "hidden"
        }
      ]
    },
    "fullscreenCopyOnSelect": {
      "type": "boolean"
    },
    "fullscreenWheelScrollLines": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "const": "auto"
        }
      ]
    },
    "queueMode": {
      "anyOf": [
        {
          "type": "string",
          "const": "all"
        },
        {
          "type": "string",
          "const": "one-at-a-time"
        }
      ]
    },
    "websockets": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "ModelThinkingLevel": {
      "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    }
  }
}
